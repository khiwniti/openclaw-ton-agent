# ── Core runtime ──────────────────────────────────────────────────────────────
# Network: mainnet | testnet
TON_NETWORK=mainnet
# Toncenter / TonAPI keys (TONAPI is the scanner enrichment layer)
TONCENTER_API_KEY=
TONAPI_KEY=

# ── OpenClaw ─────────────────────────────────────────────────────────────────
# Gateway defaults are ~/.openclaw; OPENCLAW_CONFIG_PATH points at the repo config.
OPENCLAW_CONFIG_PATH=./openclaw/openclaw.json
OPENCLAW_STATE_DIR=~/.openclaw

# ── Scanner (L1, read-only) ──────────────────────────────────────────────────
# The scanner NEVER trades. observe-only is a hard guarantee, not a flag.
OBSERVE_ONLY=true
SCAN_RADAR_INTERVAL_MS=60000
SCAN_SNIPER_INTERVAL_MS=10000
SCANNER_ENABLED=true
SNIPER_ENABLED=true
# Signal-out destination (OpenClaw webhook / signal bus)
SIGNAL_OUT_URL=
SIGNAL_OUT_SHARED_SECRET=

# ── Custody & execution (L4, @ton/mcp agentic wallets) ──────────────────────
TON_CONFIG_PATH=~/.config/ton/config.json
EXECUTION_MODE=notify_only   # notify_only | paper | auto
SIZE_CONFIRM_THRESHOLD_TON=1.0
LIVE_CONFIRM_FIRST_N_TRADES=10
# Live swaps are IMPOSSIBLE until this is 1. It acknowledges the G1–G3 gate
# progression (architecture §12.2): backtest → paper demo → live-low-tier.
GATES_G1_G3_ACK=0
EXEC_SLIPPAGE_BPS=200
EXEC_ORDER_TTL_MS=60000

# ── Risk / safety (shared with scanner CONFIG) ───────────────────────────────
KILL_SWITCH_URL=
KILL_SWITCH_POLL_MS=15000
CIRCUIT_BREAKER_DRAWDOWN_PCT=20
MAX_OPEN_POSITIONS_PER_TIER=3

# ── Risk gates (packages/risk-gates) ─────────────────────────────────────────
# Deterministic pre-trade checks. G1–G4 (architecture §12) still apply on top.
GATE_NETWORK_FEE_TON=0.1          # fee per side (x1000 fastpath worst case)
GATE_SPREAD_BPS_ALLOWANCE=200     # spread slippage allowance (bps)
GATE_MIN_RR=3                     # minimum reward/risk target
GATE_MIN_WIN_PROBABILITY=0.35
GATE_KELLY_FRACTION=0.25
GATE_COOLDOWN_MS=3600000          # per-token re-entry cooldown
GATE_MAX_DRAWDOWN_PCT=20          # halt when realized drawdown exceeds this
GATE_BANKROLL_TON=100
GATE_TIER_CEILING_HIGH_TON=20
GATE_TRADE_FLOOR_SCORE=70

# ── Data ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tonagent  # TimescaleDB series
SQLITE_PATH=./data/agent.db                                          # operational state

# ── Reporting / UI ────────────────────────────────────────────────────────────
PUBLIC_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
