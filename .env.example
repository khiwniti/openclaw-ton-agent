# === Core ===
NODE_ENV=production
TON_NETWORK=mainnet
OBSERVE_ONLY=true
OPENCLAW_CONFIG_PATH=./openclaw/openclaw.json
OPENCLAW_STATE_DIR=/app/data/.openclaw
JOURNAL_DIR=/app/data
DATA_DIR=/app/data
GATED_DIR=/app/data
ORDERS_OUT=/app/data/orders-mainnet.ndjson
FILLS_OUT=/app/data/fills-mainnet.ndjson

# === TON / External ===
TONAPI_KEY=
TONAPI_BASE=https://tonapi.io/v2
TONCENTER_API_KEY=
TON_RPC_ENDPOINT=
PUBLIC_WEBHOOK_URL=
KILL_SWITCH_URL=
KILL_SWITCH_POLL_MS=15000

# === Wallet ===
# 24-word BIP-39 mnemonic (space-separated) for the master wallet
WALLET_MASTER_MNEMONIC=
# Optional: override derived address for sanity-check validation
WALLET_ADDRESS=
WALLET_VERSION=v5r1
WALLET_SUBWALLET_ID=698983191

# === Scanner ===
SCANNER_ENABLED=true
SCAN_RADAR_INTERVAL_MS=60000
SCAN_SNIPER_INTERVAL_MS=10000

# === Orchestration ===
# Optional seed jetton master — if unset the market scanner does a live scan
SEED_JETTON_MASTER=
TIER_BALANCE_TON=10
MAX_OPEN_POSITIONS_PER_TIER=3
MAX_POSITION_TON=5
# Per-tier overrides (optional — falls back to MAX values above)
TIER_LOW_MAX_POSITION_TON=1
TIER_MID_MAX_POSITION_TON=3
TIER_HIGH_MAX_POSITION_TON=5
TIER_LOW_MAX_OPEN=2
TIER_MID_MAX_OPEN=3
TIER_HIGH_MAX_OPEN=4

# === Executor ===
EXECUTION_MODE=notify_only
EXEC_HEALTH_PORT=8081
GATES_G1_G3_ACK=0
CIRCUIT_BREAKER_DRAWDOWN_PCT=20
GATE_RISK_PER_TRADE_PCT=0.01
GATE_VOL_FLOOR_PCT=0.02
GATE_VOL_CAP_PCT=0.25
GATE_ATR_PERIOD=20

# === Runtime / transport ===
API_PORT=3000
API_HOST=0.0.0.0
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://user:***@localhost:5432/openclaw
SQLITE_PATH=/app/data/agent.db

# === Acton executor ===
ACTON_ENABLED=false
ACTON_PROJECT_PATH=.
ACTON_CONTRACT_ADDRESS=
ACTON_ROUTER_ADDRESS=

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=
# LOG_LEVEL: err | warn | trade | ok | info (default: info)
LOG_LEVEL=info
# LOG_FORMAT: json (for aggregators) | text (human readable) | auto-detect TTY
LOG_FORMAT=
